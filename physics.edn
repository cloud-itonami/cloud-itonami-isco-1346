;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": an administrative-support robot manages staff
;; scheduling, branch performance tracking and customer communications for
;; financial and insurance services branch managers (ISCO 1346). Its physical
;; work in a branch is the back office: exchanging cash cassettes in the
;; ATM dispenser, and keeping the branch's backup media in a fire-rated
;; data safe.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-1346"
 :cases
 [{:id :atm-cassette-exchange
   :kind :manipulator
   :procedure "back-office arm lifts a full note cassette from the cash trolley and seats it in the ATM dispenser slot"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 4.0 :m2-kg 3.0
            :from [0.50 -0.10] :to [0.60 0.35] :duration-s 1.5 :steps 400}
   :sweep {:param :payload-kg :values [2.0 3.5 5.0 7.0 9.0]}
   :quantity :peak-tau1-nm
   :limit {:max 60.0 :basis "estimate: continuous shoulder torque of a ~7 kg-payload collaborative arm sized for the ATM back-office bay"}
   :boundary {:lo 0.5 :hi 25.0}}
  {:id :backup-media-safe-fire
   :kind :thermal
   :procedure "branch backup media sit in a fire-rated data safe engulfed in a 900 C fire for one hour; insulation thickness swept"
   :params {:conductivity-w-mk 0.15 :density-kg-m3 900.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :t-hot-c 900.0 :h-front-w-m2k 25.0 :t-back-ambient-c 20.0 :h-back-w-m2k 3.0
            :threshold-c 52.0 :duration-s 3600.0 :nodes 21}
   :sweep {:param :thickness-m :values [0.04 0.06 0.08 0.10 0.12]}
   :quantity :final-back-c
   :limit {:max 52.0 :basis "UL 72 Class 125 record container (digital media): interior must stay below 125 F (52 C) for the rated exposure (here a constant 900 C gas, not the standard curve)"}
   :boundary {:lo 0.02 :hi 0.2}}]}
